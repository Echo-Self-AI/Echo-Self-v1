# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
env/
venv/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Build artifacts
dist/
build/
*.egg-info/

# Checkpoints (ignore all trained checkpoints by default to prevent large files in git; preserve baseline bigram.pt)
checkpoints/*
!checkpoints/bigram.pt
!checkpoints/.gitkeep
!checkpoints/**/.gitkeep


# Processed data caches and raw external datasets
data/processed/*
!data/processed/.gitkeep
data/raw/*
!data/raw/tiny_corpus.txt
!data/raw/.gitkeep

# Experiments runtime output
experiments/*
!experiments/.gitkeep

# Voice consent storage
data/consent/*
!data/consent/.gitkeep

