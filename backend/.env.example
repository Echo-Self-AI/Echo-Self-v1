APP_ENV=development
APP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echoself?sslmode=disable
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/echoself_test?sslmode=disable
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars

# Cloudflare R2 Storage (Free Tier: 10GB/mo storage, 1M Class A, 10M Class B ops, 0 egress)
# Set R2_ENABLED=true to activate real Cloudflare R2 storage in production.
# In development/test with R2_ENABLED=false, an in-memory storage driver is used.
R2_ENABLED=false
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=echoself-private-media
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto

# Media Storage & Free-Tier Cost Controls
MEDIA_MAX_UPLOAD_SIZE_BYTES=10485760
MEDIA_USER_QUOTA_BYTES=52428800
MEDIA_USER_MAX_OBJECTS=20
MEDIA_ALLOWED_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/webm,image/jpeg,image/png,image/webp
MEDIA_UPLOAD_RATE_PER_MINUTE=10
MEDIA_UPLOAD_RATE_BURST=5

# Redis & Background Worker Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
WORKER_ENABLED=false
WORKER_CONCURRENCY=2
JOB_MAX_ATTEMPTS=3
JOB_LEASE_DURATION_SECONDS=30
JOB_DRAIN_TIMEOUT_SECONDS=10